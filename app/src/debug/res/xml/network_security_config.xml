<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuración de seguridad de red — SOLO para debug.
    Permite HTTP en texto plano hacia localhost / 10.0.2.2 en debug.
    En release NO se incluye este archivo, así que HTTPS es obligatorio en producción.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
