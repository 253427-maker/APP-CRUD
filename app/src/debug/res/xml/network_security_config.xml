<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuración de seguridad de red — SOLO para debug.
    Permite HTTP en texto plano hacia 10.0.2.2 (emulador → localhost del PC).
    En release NO se incluye este archivo, así que HTTPS es obligatorio en producción.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
